**/node_modules
.git
.gitignore
.gitattributes
.dockerignore

# Build and test output inside the context is regenerated by the image build
apps/web/build
apps/web/.svelte-kit
apps/web/test-results
apps/web/.features-gen
apps/web/playwright-report
test-results/
playwright-report/
coverage
dist
dist-ssr

# Machine-local agent context never ships in an image
AGENTS.local.md
.agents/
.opencode/
.claude/
.codex/
.mcp.json
.github/
.vscode/
.zed/
.gitconfig
gitconfig/

# Docs and repo meta do not participate in image builds
docs/
README.md
LICENSE

# Human docs and agent instructions are not build inputs; the web build
# consumes its localization sources (messages/, project.inlang/) and the API
# image bakes in the frozen dataset (data/units.v2.json) — both stay in.

# Secrets never enter a build context (defensive — none exist at root)
.env*
!.env.example
**/*.key
**/*.pem
*.key
*.pem

# OS clutter
.DS_Store

# Note: data/ is intentionally NOT ignored — the API image needs the frozen
# generated dataset (data/units.v2.json), and the web build consumes its
# localization sources (messages/, project.inlang/) from the same tree.
