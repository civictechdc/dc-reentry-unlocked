{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Prettier-compatible formatter (beta — pinned exact in package.json).
  // Svelte formatting needs the `svelte` package present (it is, root + apps/web).
  "svelte": true,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "pnpm-lock.yaml",
    ".superpowers",
    ".agents/local",
    // Upstream-authored agent skill content (sveltejs/ai-tools) must stay
    // byte-identical — formatting it would fork it, and oxfmt 0.75.0 cannot
    // parse the diff-marker snippets it ships anyway. Our own skills
    // (project-orientation, data-model-reference) remain formatted.
    ".agents/skills/svelte-code-writer",
    ".agents/skills/svelte-core-bestpractices",
    // frozen generated dataset: byte-identical regeneration is the contract;
    // the formatter must not touch it
    "data",
    // generated data-model reference: byte-identical regeneration is the
    // contract (the `pnpm docgen:model` + git diff drift gate); the formatter
    // must not touch it
    "docs/data-model.md",
    // generated design-token stylesheet: byte-identical regeneration from
    // apps/web/DESIGN.md is the contract (the `pnpm design:check` export
    // gate); the formatter must not touch it
    "apps/web/src/generated/design-tokens.css",
    // in-repo OpenSpec planning artifacts: their markdown is produced and
    // maintained by the openspec workflow itself — reformatted copies would
    // fork them from the openspec tooling conventions they follow
    "openspec",
  ],
}
