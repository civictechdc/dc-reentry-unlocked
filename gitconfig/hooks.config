# Project git hooks (design D8) — Git 2.54+ config-based hooks, no hook runner.
#
# One-time per-worktree setup (see docs/git-hooks-setup.md):
#
#   git config --local include.path "$(git rev-parse --show-toplevel)/gitconfig/hooks.config"
#
# Requires git >= 2.54 and pnpm on PATH. Git runs hook commands with the
# working directory set to the repository root; commit commands receive the
# commit-message file path as their argument.

[hook "dc-fmt-lint-staged"]
	event = pre-commit
	command = ./scripts/hooks/pre-commit

[hook "dc-typecheck-arch"]
	event = pre-push
	command = ./scripts/hooks/pre-push

[hook "dc-commitlint"]
	event = commit-msg
	command = ./scripts/hooks/commit-msg
