{
  "extends": "$app/tsconfig",
  "include": ["src", "e2e"],
  "exclude": [],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "types": ["$app/types", "vite/client"]
  }
}
