{
  "name": "@dc-reentry/web",
  "version": "0.1.0",
  "private": true,
  "description": "SvelteKit frontend: map + card list of available housing units over the housing inventory API",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "e2e": "playwright test --project=desktop-chrome",
    "e2e:prod": "playwright test --project=prod"
  },
  "dependencies": {
    "@dc-reentry/shared": "workspace:*",
    "maplibre-gl": "6.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fast-check/vitest": "^0.5.0",
    "@inlang/paraglide-js": "2.29.3",
    "@inlang/plugin-m-function-matcher": "^2.3.4",
    "@inlang/plugin-message-format": "4.5.6",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@typescript/typescript6": "^6.0.2",
    "fast-check": "^4.10.2",
    "jsdom": "30.1.3",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
