{
  "name": "dc-reentry-unlocked",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared",
    "tools/datagen"
  ],
  "type": "module",
  "scripts": {
    "lint": "pnpm exec oxlint . && pnpm exec eslint .",
    "format": "pnpm exec oxfmt .",
    "format:check": "pnpm exec oxfmt --check .",
    "test": "pnpm -r run test",
    "typecheck": "pnpm exec tsc -p packages/shared && pnpm exec tsc -p apps/api && pnpm exec tsc -p tools/datagen && pnpm typecheck:web",
    "typecheck:web": "pnpm -C apps/web exec tsc6 --noEmit",
    "arch:check": "pnpm exec dependency-cruiser ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@fast-check/vitest": "^0.5.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-json": "^5.0.0",
    "oxfmt": "0.75.0",
    "oxlint": "^1.90.0",
    "svelte": "^5.57.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.15.0"
}
