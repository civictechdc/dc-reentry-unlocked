{
  "name": "dc-reentry-unlocked",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-trixie",
  "remoteUser": "node",
  "forwardPorts": [3000, 5173, 4317],
  "portsAttributes": {
    "3000": { "label": "Housing API" },
    "5173": { "label": "Web dev server" },
    "4317": { "label": "E2E prod probe", "protocol": "http" }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "mounts": [
    "source=dc-reentry-unlocked-playwright-browsers,target=/home/node/.cache/ms-playwright,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["svelte.svelte-vscode", "dbaeumer.vscode-eslint", "oxc.oxc-vscode"]
    }
  }
}
